# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_NAME=university_web
DB_USER=admintechno
DB_PASSWORD=replace-with-a-strong-database-password
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ALLOWED_ORIGINS=https://technologyfaculty.tech,https://www.technologyfaculty.tech
VITE_API_URL=/

# DNS records must point to the new server before requesting public certificates.
SITE_DOMAIN=technologyfaculty.tech
SITE_WWW_DOMAIN=www.technologyfaculty.tech
N8N_DOMAIN=n8n.technologyfaculty.tech
PUBLIC_SITE_URL=https://technologyfaculty.tech
# Match the OLD server version during migration. Do not upgrade and migrate together.
N8N_IMAGE=n8nio/n8n:2.36.8
# Copy the old n8n_data volume, including its encryption key. Do not generate a new key for existing credentials.
N8N_NEWS_WEBHOOK_URL=
N8N_NEWS_WEBHOOK_TOKEN=
N8N_KNOWLEDGE_TOKEN=
